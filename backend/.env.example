# Copy to backend/.env. Never put credentials in frontend/VITE_*.
TIDB_HOST=
TIDB_PORT=4000
TIDB_DATABASE=test
TIDB_USERNAME=
TIDB_PASSWORD=
# Optional custom CA path; otherwise use system trust store. TLS verification stays on.
TIDB_CA_PATH=
# Generate a random secret, at least 32 bytes. No default production secret.
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
