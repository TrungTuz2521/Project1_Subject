# Copy to backend/.env. Never put credentials in frontend/VITE_*.
TIDB_HOST=
TIDB_PORT=4000
TIDB_DATABASE=test
TIDB_USERNAME=
TIDB_PASSWORD=
# Optional custom CA path; otherwise use system trust store. TLS verification stays on.
TIDB_CA_PATH=
# Generate a random secret, at least 32 bytes. No default production secret.
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# VNPay deposit gateway (sandbox). Empty = POST /payments/deposit answers 503, never a fake success.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/bookings
# Bank account for the shared post-match QR. Empty = balance reports qr_unavailable_reason.
BANK_BIN=
BANK_ACCOUNT_NO=
GOOGLE_CLIENT_ID=

# Optional Gmail SMTP email notifications; requires a separate worker.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
PUBLIC_WEB_URL=http://localhost:5173
BANK_NAME=
BANK_ACCOUNT_NAME=

# SePay automatic QR confirmation (docs/setup/SEPAY_QR.md). Empty key = off, static QR + Admin receipt only.
# Same value as the "API Key" chosen when creating the SePay webhook. Never put it in frontend/VITE_*.
SEPAY_WEBHOOK_KEY=
# Seconds a QR code is shown, and how long after that a slow bank notification still confirms the hold.
SEPAY_QR_TTL_SECONDS=60
SEPAY_CONFIRM_GRACE_SECONDS=120

# Development only; simulated deposit rows are labelled DEMO and excluded from revenue.
DEMO_PAYMENT_ENABLED=false

# ---- Cloud deployment (docs/setup/DEPLOY_CLOUD.md) ----
# Number of reverse proxies in front of the app (load balancer = 1, Cloudflare + load balancer = 2). 0 locally.
TRUSTED_PROXY_HOPS=0
# Local `python run.py` only; the cloud runs `gunicorn wsgi:app` on the platform's $PORT.
HOST=127.0.0.1
PORT=5000
# Production: CORS_ORIGINS=https://<frontend domain>, PUBLIC_WEB_URL=https://<frontend domain>,
# DEMO_PAYMENT_ENABLED=false (it is refused anyway while SEPAY_WEBHOOK_KEY is set).
