# Frontend only. Never put database or payment secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:5000/api/v1
# true: local demo data; false: call Flask. Restart Vite after changes.
VITE_USE_MOCKS=false
VITE_GOOGLE_CLIENT_ID=

# Local dev only; presentation-only confirmation, never records real payment.
VITE_DEMO_DEPOSIT=false
